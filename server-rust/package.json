{
  "name": "game-lounge-android",
  "version": "1.1.0",
  "private": true,
  "description": "Game Lounge - backend Rust/Tauri pour application Android légère (frontend Vue réel)",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:frontend": "npm --prefix .. run build:mobile",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64",
    "android:build:universel": "tauri android build --apk",
    "android:build:split": "tauri android build --apk --target aarch64 --target armv7 --split-per-abi",
    "android:build:aab": "tauri android build --aab --target aarch64"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
