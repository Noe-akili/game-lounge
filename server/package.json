{
  "name": "game-lounge-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --outfile=server.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --external:nodemailer --external:@neondatabase/serverless --external:sql.js",
    "start": "node server.js",
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^2.5.2",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.17.30",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3"
  }
}
