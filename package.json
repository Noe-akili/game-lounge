{
  "name": "game-lounge",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build --config vite.config.mobile.ts",
    "preview": "vite preview",
    "server": "tsx server/server.ts",
    "seed": "tsx server/seed.ts",
    "start": "tsx server/server.ts",
    "type-check": "tsc --noEmit",
    "build:server": "node server/build-server.mjs",
    "build:electron": "electron-builder --release",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@types/sql.js": "^1.4.11",
    "@vueuse/core": "^14.4.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.2",
    "express": "^4.22.2",
    "gsap": "^3.13.0",
    "jspdf": "^2.5.2",
    "lucide-vue-next": "^0.469.0",
    "motion": "^12.23.24",
    "motion-v": "^1.7.0",
    "pinia": "^2.3.1",
    "sonner": "^1.7.4",
    "sql.js": "^1.14.2",
    "undici": "^5.29.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4",
    "vue-sonner": "^1.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/node": "^20.17.30",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.4",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "com.gamelounge.app",
    "productName": "Game Lounge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sql.js/**/*"
    ],
    "extraResources": [
      {
        "from": "server-dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Game Lounge"
    },
    "asar": true
  }
}
